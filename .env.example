# ============================
# Telegram Bot Configuration
# ============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USER_IDS=123456789,987654321

# ============================
# EducationPosts Credentials
# ============================
EDUCATIONPOSTS_USERNAME=your_educationposts_username
EDUCATIONPOSTS_PASSWORD=your_educationposts_password

# ============================
# Firebase Configuration
# ============================
# Path to your Firebase service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ============================
# Email Configuration (Optional for testing)
# ============================
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ============================
# Resend Email Service
# ============================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================
# Presentation Configuration
# ============================
PRESENTATION_PDF_PATH=docs/profesnomadas_presentation.pdf
PRESENTATION_COUNTY=all
PRESENTATION_DUBLIN_ZONE=

# ============================
# Notion CRM Configuration
# ============================
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_token
# Get database ID from the database URL: https://notion.so/workspace/DATABASE_ID?v=...
NOTION_DATABASE_ID=your_notion_database_id

# ============================
# Automatic application safety and Google Cloud audit logging
# ============================
# Production sending is fail-closed when this secret or the reservation store is unavailable.
# Generate at least 32 random characters and keep it private; placeholders/short values are rejected.
APPLICATION_AUDIT_HASH_KEY=replace_with_a_long_random_secret
# Production safety contract: daily/batch values are ceilings; spacing/pause values
# are floors. Unsafe production overrides are clamped. Only APPLICATION_AUDIT_ENVIRONMENT=test
# permits fast values in an isolated test process.
# The daily window is UTC and charges the reservation's scheduled delivery date.
APPLICATION_SEND_DAILY_LIMIT=100
APPLICATION_SEND_BATCH_LIMIT=10
APPLICATION_SEND_MIN_INTERVAL_SECONDS=10
APPLICATION_SEND_BATCH_PAUSE_SECONDS=300
# Cloud Logging is opt-in. Requires GOOGLE_APPLICATION_CREDENTIALS for the target project.
GOOGLE_CLOUD_AUDIT_LOGGING_ENABLED=false
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_AUDIT_LOG_NAME=profes_nomadas_application_audit
APPLICATION_AUDIT_ENVIRONMENT=production
# Optional non-personal deployment label (for example, prod-worker-eu-1); omitted by default.
APPLICATION_AUDIT_HOST=
